# Database (Postgres — Supabase/Neon/Railway all fine)
DATABASE_URL=

# App
APP_URL=http://localhost:3000

# Clerk (auth)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Stripe — create products/prices in the Stripe dashboard, paste IDs here.
# Changing an offer's price = change it in Stripe. No code edits, ever.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
STRIPE_PRICE_BUMP=
STRIPE_PRICE_AUDIT=

# Discord — server layout is yours to change; the bot only needs these IDs
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_ROLE_MEMBER=
DISCORD_ROLE_FOUNDERS=
DISCORD_ROLE_ARTISTS=

# Discord OAuth (account linking at /onboarding — separate from the bot token).
# Create an app at discord.com/developers/applications, add an OAuth2 redirect
# of "<APP_URL>/api/discord/callback", paste the client id/secret here.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Optional bot extras (Phase 3): announcement channel + rank->role JSON map.
# Leave empty to skip either feature.
DISCORD_CHANNEL_ANNOUNCEMENTS=
DISCORD_RANK_ROLES={}

# Phase 4 (setter queue sync — leave empty until built)
NOTION_API_KEY=
NOTION_SETTER_DB_ID=
