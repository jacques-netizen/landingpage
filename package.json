{
  "name": "content-rewards-platform",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint . && node scripts/check-copy.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --if-present test",
    "db:generate": "pnpm --filter @mde/db generate",
    "db:check": "pnpm --filter @mde/db check",
    "db:migrate": "pnpm --filter @mde/db migrate",
    "db:seed": "pnpm --filter @mde/db seed",
    "dev": "pnpm --filter @mde/web dev",
    "build": "pnpm --filter @mde/web build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "globals": "^16.0.0",
    "prettier": "^3.6.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
