{
  "wz": "\"var(--mde-app-zoom)\"",
  "$hide": ["list:bstates", "text:{{ c.rate }} / 1k"],
  "$text": {
    "Search campaigns, labels or platforms": "<input type=\"search\" aria-label=\"Search campaigns, labels or platforms\" placeholder=\"Search campaigns, labels or platforms\" value={v.search} onChange={v.onSearch} className=\"mde-search\" />",
    "Sign in": "{v.account.label}",
    "Clipping": "{v.featured.tag1}",
    "TikTok": "{v.featured.tag2}",
    "Sample clipping campaign": "{v.featured.title}",
    "Cut the best moments, post on your own account, and earn $2.00 for every 1,000 counted views.": "{v.featured.body}",
    "$4,800.00 left": "{v.featured.leftLabel}",
    "Sample data and artwork for layout only.": "{v.past}"
  },
  "$attach": {
    "div:Sign in": {
      "onClick": "v.account.go"
    },
    "div:View campaign": {
      "onClick": "v.featured.go"
    },
    "style:position:relative;height:330px;border-radius:24px;overflow:hidden": {
      "onClick": "c.go"
    },
    "style:flex:1;height:48px;border-radius:14px": {
      "data-search": "1"
    }
  },
  "$if": {
    "position:relative;color:#F4F1EA;height:370px": "v.featured",
    "height:48px;padding:0 22px;border-radius:14px": "v.account"
  },
  "$mark": {
    "a-page": "padding:40px 24px 96px",
    "a-zoom": "zoom:{{ wz }}",
    "a-frame": "width:1240px;margin:0 auto;box-sizing:border-box;padding:16px;border-radius:38px",
    "a-side": "width:220px;flex:none;box-sizing:border-box;padding:22px 16px",
    "a-top": "=display:flex;gap:12px;align-items:center",
    "a-search": "flex:1;height:48px;border-radius:14px",
    "a-hero": "position:relative;color:#F4F1EA;height:370px",
    "a-hero-pill": "position:absolute;left:36px;top:32px",
    "a-hero-text": "position:absolute;left:36px;bottom:36px;max-width:430px",
    "a-hero-title": "font:700 44px/1.05",
    "a-grid": "display:grid;grid-template-columns:repeat(4,1fr);gap:16px",
    "a-hero-shade": "background:linear-gradient(90deg,rgba(12,10,18,0.92)",
    "a-hero-buttons": "margin-top:22px;display:flex;gap:12px;align-items:center"
  },
  "$children": {
    "width:220px;flex:none;box-sizing:border-box;padding:22px 16px": "v.menu"
  },
  "$attrs": {
    "src=assets/camp-hero.png": "v.featured.img"
  }
}
