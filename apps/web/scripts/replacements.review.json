{
  "$hide": ["text:Sample data for layout only."],
  "$text": {
    "Oldest first": "{v.subtitle}",
    "TikTok · Sample clipping campaign · Submitted Oct 2": "{v.meta}",
    "embedded post": "{v.embedLabel}",
    "Note to creator": "<textarea className=\"mde-note\" aria-label=\"Note to creator\" placeholder=\"Note to creator\" value={v.note} onChange={v.onNote} />"
  },
  "$children": {
    "display:flex;gap:8px;flex-wrap:wrap;margin-top:10px": "(v.reasons as { label: string; go: () => void; on: boolean }[]).map((r, i: number) => <span key={i} {...clickable(r.go)} aria-pressed={r.on} style={css({ \"height\": \"36px\", \"padding\": \"0 16px\", \"borderRadius\": \"999px\", \"border\": r.on ? \"1px solid #1A1510\" : \"1px solid #CDBFA8\", \"display\": \"flex\", \"alignItems\": \"center\", \"fontSize\": \"13px\", \"background\": r.on ? \"#1A1510\" : \"transparent\", \"color\": r.on ? \"#fff\" : \"inherit\", \"cursor\": \"pointer\" })}>{r.label}</span>)"
  },
  "$attach": {
    "span:Dashboard": { "onClick": "v.nav.dashboard" },
    "span:Campaigns": { "onClick": "v.nav.campaigns" },
    "span:Review queue": { "onClick": "v.nav.review" },
    "span:Creators": { "onClick": "v.nav.creators" },
    "span:Appeals": { "onClick": "v.nav.appeals" },
    "span:Ledger": { "onClick": "v.nav.ledger" },
    "span:Payouts": { "onClick": "v.nav.payouts" },
    "span:Settings": { "onClick": "v.nav.settings" },
    "span:Audit log": { "onClick": "v.nav.audit" },
    "style:padding:14px 24px;border-top:1px solid #E0D6C6": { "onClick": "q.go" },
    "div:Post detail": { "onClick": "v.openDetail" },
    "style:margin-top:20px;height:200px;border-radius:14px": { "onClick": "v.openPost" },
    "style:margin-top:20px;height:80px;border:1px solid #CDBFA8": { "data-note": "1" },
    "div:Approve": { "onClick": "v.approve" },
    "div:Reject": { "onClick": "v.reject" }
  },
  "$if": {
    "flex:1;padding:32px 40px;max-width:760px": "v.current"
  }
}
