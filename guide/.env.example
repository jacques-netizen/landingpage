# Interactive guide funnel. Copy to .env.local for local work.
# Every variable from section 13 of the build plan is listed. Anything left
# empty falls back to a safe local mode (logged, not sent) so the app runs
# without third party accounts.

# Public origin of this app, no trailing slash.
SITE_URL=https://guide.maisondelites.com

# Postgres (Neon or Supabase). Leave empty for a local embedded database
# (PGlite, stored in .data/pglite). Use "pglite:memory" for tests.
DATABASE_URL=

# Secret used to sign guide links and the session cookie. 32+ random chars.
APP_SECRET=

# GoHighLevel (private integration token for the single sub-account).
GHL_API_TOKEN=
GHL_LOCATION_ID=
# Pipeline names as they appear in GHL. Ids are read through the API.
GHL_PIPELINE_DM_SETTING=DM Setting
GHL_PIPELINE_SALES=Sales
# Stage names per pipeline, matched by name through the API. "first" means the
# first stage. Read from the live sub-account on 2026-10-08: DM Setting starts
# at "New Lead", Sales starts at "Call Booked".
GHL_STAGE_MAP={"dm_setting_new":"New Lead","sales_booked":"Call Booked"}
# Base URL for contact links in Discord alerts.
GHL_APP_URL=https://app.gohighlevel.com

# Cal.com
CAL_BOOKING_URL=https://cal.com/maisondelites/discovery
CAL_WEBHOOK_SECRET=
# Where Cal.com sends people after a booking (existing pre-call page).
CAL_BOOKED_REDIRECT_URL=https://book.maisondelites.com/booked

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=Maison d'Élites <guide@maisondelites.com>
EMAIL_REPLY_TO=
EMAIL_FOOTER_LEGAL=Maison d'Élites
EMAIL_SIGNATURE=Maison d'Élites

# Video. "file" serves the mp4 and poster paths in content/media.json as is.
# "mux" treats ids as Mux playback ids (HLS from stream.mux.com).
VIDEO_PROVIDER=file
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# Object storage for generated PDFs (Cloudflare R2, S3 API). Leave empty to
# store PDFs on local disk under .data/guides.
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=auto

# Meta Pixel and Conversions API
META_PIXEL_ID=
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=

# Discord team channel webhook
DISCORD_WEBHOOK_URL=

# ManyChat
MANYCHAT_API_TOKEN=
MANYCHAT_TAG_NAME=guide-requested

# Cloudflare Turnstile. Leave both empty to skip the bot check locally.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Clipper network join link
WHOP_JOIN_URL=https://whop.com/maison-delites

# Qualification thresholds in dollars
BUDGET_QUALIFY_MIN=3000
BUDGET_PRIORITY_MIN=10000

# Share of new sessions on the full experience, 0 to 1. The rest get "plain".
VARIANT_SPLIT=0.5
# Share of sessions with the front loaded progress bar, 0 to 1.
PROGRESS_SPLIT=0.5

# Kill switch. "false" sends every visitor to OLD_GUIDE_URL.
FUNNEL_ENABLED=true
OLD_GUIDE_URL=

# Password for /dashboard (funnel numbers).
DASHBOARD_PASSWORD=

# Secret for /api/cron/jobs (Vercel Cron sends it as a bearer token).
CRON_SECRET=
